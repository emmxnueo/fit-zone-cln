  "components": {
    "schemas": {
      "DecisionIn": {
        "properties": {
          "aprobada": {
            "type": "boolean",
            "title": "Aprobada",
            "description": "Resolución del Administrador sobre la solicitud de excepción (RN-09, RN-10)."
          }
        },
        "type": "object",
        "required": [
          "aprobada"
        ],
        "title": "DecisionIn"
      },
      "ErrorOut": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "regla": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Regla"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorOut"
      },
      "EstadoMembresia": {
        "type": "string",
        "enum": [
          "SOLICITADA",
          "ACTIVA",
          "SUSPENDIDA",
          "VENCIDA",
          "CANCELADA"
        ],
        "title": "EstadoMembresia"
      },
      "EvaluacionOut": {
        "properties": {
          "cumple": {
            "type": "boolean",
            "title": "Cumple"
          },
          "motivos": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Motivos"
          }
        },
        "type": "object",
        "required": [
          "cumple",
          "motivos"
        ],
        "title": "EvaluacionOut"
      },
      "EventoOut": {
        "properties": {
          "evento": {
            "type": "string",
            "title": "Evento"
          },
          "solicitud_id": {
            "type": "string",
            "title": "Solicitud Id"
          },
          "socio_id": {
            "type": "string",
            "title": "Socio Id"
          },
          "ocurrido_en": {
            "type": "string",
            "format": "date-time",
            "title": "Ocurrido En"
          }
        },
        "type": "object",
        "required": [
          "evento",
          "solicitud_id",
          "socio_id",
          "ocurrido_en"
        ],
        "title": "EventoOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
