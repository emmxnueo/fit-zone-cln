# Copia este archivo a .env y ajusta los valores. NO subas .env a GitHub.
POSTGRES_USER=fitzone
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=fitzone
POSTGRES_HOST=db
POSTGRES_PORT=5432
# URL completa que usa la app (en local sin Docker usa localhost como host)
DATABASE_URL=postgresql+psycopg://fitzone:cambia_esta_clave@db:5432/fitzone
APP_PORT=8000
